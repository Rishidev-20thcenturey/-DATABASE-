# Copy to backend/.env and fill in. Never commit .env.
# The server refuses to start if a required value is missing or malformed (see src/config/env.ts).

# development | test | production
NODE_ENV=development
PORT=4000

# PostgreSQL connection string (required)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/food_delivery

# Access token signing secret. Required, at least 32 characters. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated browser origins allowed to call the API with credentials (the frontend URL).
CORS_ORIGINS=http://localhost:5173

# Refresh-token cookie settings. Use COOKIE_SECURE=true and COOKIE_SAMESITE=none when the frontend
# and API are on different sites over HTTPS.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Cash on delivery is the only payment method implemented. Set to false to disable checkout.
ENABLE_COD=true

# Set TRUST_PROXY=true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Rate limits per 15-minute window per client IP.
AUTH_RATE_LIMIT_MAX=20
API_RATE_LIMIT_MAX=300

# Password for the development seed accounts (npm run db:seed). Ignored in production, and the seed refuses to run there.
DEV_SEED_PASSWORD=change-me-dev-only
